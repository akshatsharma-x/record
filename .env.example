# The composer's connections (lib/contact-server.ts). Copy to .env.local and fill in.
# Without them, development uses a console transport and an in-memory rate limit, and a
# production build answers 503, so the page offers the visitor's mail app instead.

# Delivery, through Resend (https://resend.com).
RESEND_API_KEY=
# Who messages are from. Resend's onboarding sender can write only to the account's own
# address until a domain is verified.
CONTACT_FROM=
# Where messages go. Defaults to the profile's email in content/data.ts.
CONTACT_TO=

# The rate limit (5 an hour per IP and per sender), through Upstash Redis (https://upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "console" to use the console transport and an in-memory limit in a production
# build too (the end-to-end tests do). Never set it in a real deployment.
CONTACT_TRANSPORT=

# Ask (lib/ask/server.ts): answers to questions in Search, from the site's own content.
# Without ASK_ENABLED=true and a key, Search answers from the site's own text instead, and
# says so. The rate limits (10 a minute per IP, 200 a day in all) use the Upstash keys above;
# a production build without them generates nothing.
ASK_ENABLED=
# Anthropic's API key (https://platform.claude.com).
ANTHROPIC_API_KEY=
# The model. Defaults to claude-opus-5-5.
ASK_MODEL=
# Set to "memory" to keep Ask's limits in memory in a production build (local evaluation
# only). Never set it in a real deployment.
ASK_LIMIT=

# Set by Vercel, never by hand (Part 16): VERCEL turns on Web Analytics, cookieless
# (app/layout.tsx), and VERCEL_PROJECT_PRODUCTION_URL is the site's address for canonical
# links, share cards and the sitemap (lib/site.ts) until content has one (profile.links.site).
