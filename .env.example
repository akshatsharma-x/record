# The composer's connections (lib/contact-server.ts). Copy to .env.local and fill in.
# Without them, development uses a console transport and an in-memory rate limit, and a
# production build answers 503, so the page offers the visitor's mail app instead.

# Delivery, through Resend (https://resend.com).
RESEND_API_KEY=
# Who messages are from. Resend's onboarding sender can write only to the account's own
# address until a domain is verified.
CONTACT_FROM=
# Where messages go. Defaults to the profile's email in content/data.ts.
CONTACT_TO=

# The rate limit (5 an hour per IP and per sender), through Upstash Redis (https://upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "console" to use the console transport and an in-memory limit in a production
# build too (the end-to-end tests do). Never set it in a real deployment.
CONTACT_TRANSPORT=
