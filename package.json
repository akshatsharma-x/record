{
  "name": "classyfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/portrait-fixture.mjs && next dev",
    "fixtures": "node scripts/portrait-fixture.mjs",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON content/check.ts",
    "build": "next build",
    "postbuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/csp.ts && vitest run tests/unit/privacy.test.ts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "size": "NODE_OPTIONS=--disable-warning=MODULE_TYPELESS_PACKAGE_JSON size-limit",
    "lighthouse": "lhci autorun",
    "measure": "lhci collect && lhci upload && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/measure.ts",
    "scan-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scan-history.ts",
    "analyze": "next analyze"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "16.38.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "jsqr": "1.4.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
